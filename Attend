<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Attendance Management</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      margin: 0;
      padding: 30px;
      color: #172554;
    }
    main {
      max-width: 850px;
      margin: 30px auto;
      background: white;
      padding: 30px;
      border-radius: 14px;
    }
    h1 { color: #1d4ed8; }
    input, button {
      padding: 12px;
      margin: 6px 0;
      border-radius: 6px;
    }
    input { border: 1px solid #cbd5e1; }
    button {
      background: #2563eb;
      color: white;
      border: 0;
      cursor: pointer;
    }
    table { width: 100%; margin-top: 20px; }
    th, td { padding: 10px; text-align: left; }
  </style>
</head>
<body>
  <main>
    <h1>Student Attendance Management</h1>
    <p>Cloud-based college attendance dashboard</p>

    <h2>Mark Attendance</h2>
    <input id="student" placeholder="Student name">
    <button onclick="markAttendance()">Mark Present</button>

    <h2>Attendance Records</h2>
    <table>
      <thead>
        <tr><th>Student</th><th>Date</th><th>Status</th></tr>
      </thead>
      <tbody id="records"></tbody>
    </table>
  </main>

  <script>
    function markAttendance() {
      const input = document.getElementById("student");
      const name = input.value.trim();
      if (!name) {
        alert("Enter a student name");
        return;
      }

      const row = document.createElement("tr");
      [name, new Date().toLocaleDateString(), "Present"].forEach(value => {
        const cell = document.createElement("td");
        cell.textContent = value;
        row.appendChild(cell);
      });

      document.getElementById("records").appendChild(row);
      input.value = "";
    }
  </script>
</body>
</html>
